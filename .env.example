# Telegram Bot Token от @BotFather
BOT_TOKEN=your_bot_token_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# База данных (Railway автоматически предоставит PostgreSQL URL)
DATABASE_URL=sqlite:///taskbridge.db

# Домен для веб-приложения (Railway автоматически установит)
# Формат: https://your-app.up.railway.app
WEB_APP_DOMAIN=http://localhost:8000

# Порт (Railway автоматически установит)
PORT=8000

# Хост
HOST=0.0.0.0

# Webhook (для production)
USE_WEBHOOK=False
WEBHOOK_URL=https://your-domain.com
